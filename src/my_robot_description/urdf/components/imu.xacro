<?xml version="1.0"?>
<!-- Measurement only: no new link, joint, mass, or controller. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo reference="base_link">
    <sensor name="pelvis_imu" type="imu">
      <!-- Sensor axes and origin coincide with the existing base_link frame. -->
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/biped/imu</topic>
      <imu>
        <!-- Reference orientation to the world, rather than the initial pose. -->
        <orientation_reference_frame>
          <localization>CUSTOM</localization>
          <custom_rpy parent_frame="world">0 0 0</custom_rpy>
        </orientation_reference_frame>
      </imu>
    </sensor>
  </gazebo>
</robot>
